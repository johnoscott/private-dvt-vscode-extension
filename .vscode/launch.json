{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (jaffle_shop)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test/fixtures/jaffle_shop"
